# Docker 部署配置（复制为 .env）
# 本仓库发布的 Docker Hub 镜像地址；参见 README 的部署说明。
VULNHUNT_IMAGE=ruoji6/vulnhunt
VULNHUNT_TAG=latest
POSTGRES_USER=vulnhunt
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=vulnhunt

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VULNHUNT_LLM_PROVIDER=
VULNHUNT_LLM_MODEL=
VULNHUNT_LLM_BASE_URL=
VULNHUNT_LLM_PROXY=
