#!/bin/sh
# Secret scan for staged changes.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# CI runs the full-history scan; this hook is a fast local guard.
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "gitleaks not found; skipping secret scan (install: https://github.com/gitleaks/gitleaks)" >&2
    exit 0
fi

gitleaks git --pre-commit --staged --redact --config .gitleaks.toml
